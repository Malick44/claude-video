# --- Data layer (Supabase: Postgres + pgvector + Storage) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Ingestion (Apify) ---
APIFY_TOKEN=
APIFY_WEBHOOK_SECRET=            # random string; Apify sends it back as x-webhook-secret
APP_URL=https://intel.example.com # public URL Apify calls back to
# Optional actor overrides (owner~name)
# APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper
# APIFY_INSTAGRAM_ACTOR=apify~instagram-reel-scraper
# APIFY_YOUTUBE_ACTOR=streamers~youtube-shorts-scraper
# INGEST_CRON=0 */6 * * *

# --- Media + analysis ---
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                  # embeddings only (text-embedding-3-small, 1536-d)
# ANALYSIS_MODEL=claude-opus-5
# OUTLIER_THRESHOLD=2.5          # OM >= this => "Viral Outlier"
# ANALYZE_MIN_MULTIPLIER=1.5     # only run the multimodal pass at/above this OM (0 = everything)
# PROCESS_CONCURRENCY=4

# --- Orchestration (Inngest) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# INNGEST_DEV=1                  # local: talk to `npm run inngest:dev`

# --- Dashboard ---
# DASHBOARD_PASSWORD=            # enables HTTP basic auth on the UI
